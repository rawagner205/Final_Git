    <ui:Label text="&#x9;" name="UIConsole" emoji-fallback-support="false" style="align-self: center; border-top-width: 10px; border-right-width: 10px; border-bottom-width: 10px; border-left-width: 10px; border-left-color: rgb(0, 206, 209); border-right-color: rgb(0, 206, 209); border-top-color: rgb(0, 206, 209); border-bottom-color: rgb(0, 206, 209); width: 100%; font-size: 40%; color: rgb(255, 255, 255); -unity-text-align: upper-center; background-color: rgb(0, 0, 0); align-items: stretch;" />
    <ui:Button text="Play Again" name="RestartButton" style="color: rgb(255, 255, 255); background-color: rgb(0, 0, 0); align-self: center; font-size: 30px; justify-content: flex-end; align-items: auto; align-content: auto; -unity-text-align: middle-center; white-space: normal; height: 83px; border-left-color: rgb(255, 105, 180); border-right-color: rgb(255, 105, 180); border-top-color: rgb(255, 105, 180); border-bottom-color: rgb(255, 105, 180); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; translate: 0 200px;" />
